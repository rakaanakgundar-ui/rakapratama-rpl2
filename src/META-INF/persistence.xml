<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://www.eclipse.org/eclipselink/xsds/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.eclipse.org/eclipselink/xsds/persistence
             http://www.eclipse.org/eclipselink/xsds/eclipselink/persistence/orm/eclipselink-persistence_2.6.xsd"
             version="2.1">

    <persistence-unit name="KaboyGaragePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernateJpaProvider</provider>

        <!-- Entities -->
        <class>kaboygarage.model.Orang</class>
        <class>kaboygarage.model.Admin</class>
        <class>kaboygarage.model.Pelanggan</class>
        <class>kaboygarage.model.Kendaraan</class>
        <class>kaboygarage.model.SparePart</class>
        <class>kaboygarage.model.Pesanan</class>
        <class>kaboygarage.model.DetailPesanan</class>
        <class>kaboygarage.model.PendaftaranServis</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Database connection -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/kaboy_garage?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Jakarta&amp;characterEncoding=UTF-8"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Hibernate configuration -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
            <property name="hibernate.jdbc.batch_size" value="20"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>

            <!-- Connection pooling -->
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>
        </properties>
    </persistence-unit>

</persistence>
